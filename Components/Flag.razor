<div class="@_cssClass" style="width: @(FlagCatalog.Css(_width))px; --flag-w: @(FlagCatalog.Css(_width))px; --billow: @(FlagCatalog.Css(Billow))px; --flag-bg: @_background;" @attributes="_accessibilityAttributes">
    @for (int i = 0; i < _columns; i++) {
        string offset = FlagCatalog.Css(-(i * _columnWidth));

        @* Every column paints the full-width design shifted left, so it shows only its own slice and the design waves with the fabric *@
        <div class="column" style="animation-delay: @(_firstDelay + (i * StaggeredDelay))ms; background-position: @(offset)px 0;">
            @if (_hasLogo) {
                <div class="logo" style="left: @(offset)px;">
                    <img src="@LogoUrl" alt="" decoding="async" />
                </div>
            }
        </div>
    }
</div>

@code {
    private static readonly Dictionary<string, object> DecorativeAttributes = new() { ["aria-hidden"] = "true" };

    private int _columns;
    private double _columnWidth;
    private double _width;
    private int _firstDelay;
    private bool _hasLogo;
    private string _cssClass = "flag";
    private string _background = string.Empty;
    private Dictionary<string, object> _accessibilityAttributes = DecorativeAttributes;

    [Parameter] public FlagColor Variant { get; set; } = FlagColor.RainbowOriginal;
    [Parameter] public string[]? CustomColors { get; set; }
    [Parameter] public double Width { get; set; } = 200;
    [Parameter] public int NumOfColumns { get; set; } = 10;
    [Parameter] public int StaggeredDelay { get; set; } = 150;
    [Parameter] public double Billow { get; set; } = 3;

    // URL of an image or SVG drawn centered across the flag
    [Parameter] public string LogoUrl { get; set; } = string.Empty;

    // Accessible name for the flag; when empty the flag is treated as decorative and hidden from assistive tech
    [Parameter] public string? Label { get; set; }

    protected override void OnParametersSet() {
        _columns = Math.Max(1, NumOfColumns);
        _columnWidth = Math.Round(Width / _columns);
        _width = _columnWidth * _columns;
        _firstDelay = -(_columns * StaggeredDelay);
        _hasLogo = !string.IsNullOrWhiteSpace(LogoUrl);

        if (CustomColors is { Length: > 0 }) {
            _background = FlagCatalog.BuildGradient(CustomColors, false);
            _cssClass = "flag";
        }
        else {
            FlagDefinition definition = FlagCatalog.Get(Variant);
            _background = FlagCatalog.GetBackground(definition.Variant);
            _cssClass = definition.Image is null ? "flag" : $"flag flag-{definition.Image}";
        }

        _accessibilityAttributes = string.IsNullOrWhiteSpace(Label)
            ? DecorativeAttributes
            : new() { ["role"] = "img", ["aria-label"] = Label };
    }
}